# Production Environment Variables
# À copier et remplir sur Render → Web Service → Environment

# Node environment
NODE_ENV=production

# Server
PORT=5000
API_URL=https://citoyenavise.org/api

# Database (fourni automatiquement par Render)
DATABASE_URL=postgresql://user:password@host:5432/citoyenavise
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT=30000

# JWT Secrets (générer avec: openssl rand -base64 32)
JWT_SECRET=VOTRE_CLE_SECRETE_JWT_ICI
JWT_REFRESH_SECRET=VOTRE_CLE_SECRETE_REFRESH_ICI
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optionnel)
REDIS_URL=redis://:password@host:6379/0

# CORS
CORS_ORIGIN=https://citoyenavise.org

# Sentry (optionnel, pour error tracking)
SENTRY_DSN=

# Email (optionnel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=info
