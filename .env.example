################################
# 🔧 CONFIGURATION BACKEND
# Copier ce fichier en .env et ajuster
################################

# 🗄️  DATABASE
# =======================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citoyenavise_dev
DB_POOL_SIZE=10
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=citoyenavise_dev
DB_HOST=localhost
DB_PORT=5432

# 🔐 JWT Authentication
# =======================================
# IMPORTANT: Générer des clés aléatoires min 32 caractères en prod!
# openssl rand -base64 32
# ATTENTION: JWT_SECRET et JWT_REFRESH_SECRET DOIVENT ÊTRE DIFFÉRENTS!
JWT_SECRET=your_super_secret_key_min_32_chars_CHANGE_IN_PRODUCTION_NOW
JWT_REFRESH_SECRET=your_different_refresh_secret_min_32_chars_CHANGE_IN_PRODUCTION_NOW
JWT_EXPIRY_ACCESS=24h
JWT_EXPIRY_REFRESH=7d

# 🚀 SERVER
# =======================================
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# 📊 LOGGING
# =======================================
LOG_LEVEL=debug
# Options: error, warn, info, debug

# 🌐 CORS (Cross-Origin Resource Sharing)
# =======================================
# Ajouter les domaines autorisés (séparés par des virgules)
CORS_ORIGIN=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# 💾 REDIS CACHE (Optionnel)
# =======================================
# Si vide = cache désactivé
# Utiliser pour améliorer la performance sur GET /popular/*
REDIS_URL=redis://localhost:6379
# Alternative avec variables:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USER=default

# 📧 EMAIL (Futur)
# =======================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@citoyenavise.org
SMTP_PASS=your_email_password
SMTP_FROM=noreply@citoyenavise.org

# 🗺️  PostGIS Géolocalisation
# =======================================
POSTGIS_ENABLED=true

# 📌 Sentry Error Tracking (Optionnel)
# =======================================
# Activer le tracking d'erreurs en production
SENTRY_DSN=

# 🎯 Feature Flags (Optionnel)
# =======================================
# FEATURE_WEBSOCKETS=true
# FEATURE_SEARCH=true
# FEATURE_ANALYTICS=true

# 🔍 Security
# =======================================
# Clés secrètes pour signatures
# Générer: openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key_32_chars_minimum_CHANGE_IN_PRODUCTION

################################
# ⚠️  PRODUCTION ONLY
# =======================================
# Décommenter et configurer en production

# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
